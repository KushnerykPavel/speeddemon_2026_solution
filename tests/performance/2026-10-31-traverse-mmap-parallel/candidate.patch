+fn parse_chunks(
+    chunks: &[&[u8]],
+    visit: impl Fn([u32; 3]) -> io::Result<()> + Sync,
+) -> io::Result<usize> {
+    thread::scope(|scope| {
+        let handles: Vec<_> = chunks
+            .iter()
+            .map(|&chunk| {
+                let visit = &visit;
+                scope.spawn(move || {
+                    let mut count = 0;
+                    for line in chunk.split_inclusive(|&byte| byte == b'\n') {
+                        visit(parse_fields(line)?)?;
+                        count += 1;
+                    }
+                    Ok::<_, io::Error>(count)
+                })
+            })
+            .collect();
+        handles
+            .into_iter()
+            .map(|handle| {
+                handle
+                    .join()
+                    .map_err(|_| io::Error::other("graph worker panicked"))?
+            })
+            .sum()
+    })
+}
